---
import { getEntry, render } from "astro:content";

import Base from "../layouts/Base.astro";
import Panel from "../components/Panel.astro";
import SectionHeader from "../components/SectionHeader.astro";
import LinkList from "../components/LinkList.astro";
import { getKeyFile } from "../lib/keys";

const page = await getEntry("pages", "contact");
if (!page) throw new Error("src/content/pages/contact.md is missing");
const { Content } = await render(page);

const keys = page.data.keys.map((key) => ({
  ...key,
  body: getKeyFile(key.file).body,
  /** Served by src/pages/keys/[file].ts, so `gpg --fetch-keys` works. */
  href: `/keys/${key.file}`,
}));
---

<Base
  title="Contact"
  description="How to reach Kien Tuong Truong, and public keys."
>
  <Panel labelledby="contact-head">
    <SectionHeader as="h1" id="contact-head">contact</SectionHeader>
    <div class="prose">
      <Content />
    </div>
  </Panel>

  <Panel id="public-keys" labelledby="keys-head">
    <SectionHeader id="keys-head">public keys</SectionHeader>
    <div class="keys">
      {
        keys.map((key) => (
          <div>
            <h3 class="key__title">{key.title}</h3>
            {key.fingerprint && (
              <p class="key__fingerprint">Fingerprint: {key.fingerprint}</p>
            )}
            <LinkList
              links={[{ label: key.file, url: key.href }]}
              label={`Download ${key.title}`}
            />
            {/* prettier-ignore */}
            <pre class="key__block"><code>{key.body}</code></pre>
          </div>
        ))
      }
    </div>
  </Panel>
</Base>
