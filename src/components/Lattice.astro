---
import { rng, lattice } from "../lib/geom";

interface Props {
  seed: number;
}

const { seed }: Props = Astro.props;

const W = 1600;
const H = 1000;
const r = rng(seed ^ 0x5eed);

/**
 * A node scatter with short-range links, drawn once and never touched again.
 *
 * This was briefly animated — a transform on the group, opacity on sub-groups
 * — which meant repainting hundreds of vector elements every frame and was
 * visibly janky. It stays static.
 */
const { nodes, links } = lattice(r, W, H, 40, 235, 46);
---

<svg
  class="lattice"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {
    links.map((l) => (
      <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} class="lattice__link" />
    ))
  }
  {nodes.map((n) => <circle cx={n.x} cy={n.y} r="2.2" class="lattice__node" />)}
</svg>
