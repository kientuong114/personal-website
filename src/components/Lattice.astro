---
import { rng, between, lattice } from "../lib/geom";

interface Props {
  seed: number;
}

const { seed }: Props = Astro.props;

const W = 1600;
const H = 1000;
const r = rng(seed ^ 0x5eed);

const { nodes, links } = lattice(r, W, H, 110, 205, 140);

/**
 * The lattice pulses in a handful of groups rather than per element.
 *
 * Animating every link and node individually meant well over a hundred
 * permanently running animations, each a candidate for its own compositor
 * layer — enough that the browser started dropping other animations on the
 * page. Members are handed out round-robin, so each group is spread across
 * the whole field and the result still reads as individual connections
 * coming and going.
 */
const GROUPS = 10;

const cycles = Array.from({ length: GROUPS }, () => ({
  period: `${between(r, 16, 38).toFixed(1)}s`,
  delay: `-${between(r, 0, 38).toFixed(1)}s`,
}));

const groups = cycles.map((cycle, g) => ({
  ...cycle,
  links: links.filter((_, i) => i % GROUPS === g),
  nodes: nodes.filter((_, i) => i % GROUPS === g),
}));
---

<svg
  class="lattice"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g class="lattice__drift">
    <g class="lattice__float">
      {
        groups.map((group) => (
          <g
            class="lattice__pulse"
            style={`--period:${group.period}; --delay:${group.delay}`}
          >
            {group.links.map((l) => (
              <line
                x1={l.x1}
                y1={l.y1}
                x2={l.x2}
                y2={l.y2}
                class="lattice__link"
              />
            ))}
            {group.nodes.map((n) => (
              <circle cx={n.x} cy={n.y} r="2.4" class="lattice__node" />
            ))}
          </g>
        ))
      }
    </g>
  </g>
</svg>
