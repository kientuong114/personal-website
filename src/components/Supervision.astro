---
import { render, type CollectionEntry } from "astro:content";
import LinkList from "./LinkList.astro";

interface Props {
  entry: CollectionEntry<"supervision">;
}

const { entry } = Astro.props;
const { student, project, projectUrl, kind, coAdvisors, links, date } =
  entry.data;

const year = date.getUTCFullYear();

// "Master's thesis · co-advised with X and Y", omitting whichever is absent.
const advisors =
  coAdvisors.length > 0
    ? `co-advised with ${new Intl.ListFormat("en", { style: "long", type: "conjunction" }).format(coAdvisors)}`
    : "";
const attribution = [kind, advisors].filter(Boolean).join(" · ");

const hasNotes = Boolean(entry.body?.trim());
const { Content } = await render(entry);
---

<li class="entry">
  <div class="entry__year">{year}</div>

  <div class="entry__body">
    <h3 class="entry__title">{student}</h3>

    <p class="entry__project">
      {
        projectUrl ? (
          <a href={projectUrl} rel="noopener">
            {project}
          </a>
        ) : (
          project
        )
      }
    </p>

    {attribution && <p class="entry__venue">{attribution}</p>}

    <LinkList links={links} label={`Links for ${student}`} />

    {
      hasNotes && (
        <div class="prose">
          <Content />
        </div>
      )
    }
  </div>
</li>
