---
import { render, type CollectionEntry } from "astro:content";
import LinkList from "./LinkList.astro";

interface Props {
  entry: CollectionEntry<"courses">;
}

const { entry } = Astro.props;
const { course, role, institution, terms, links } = entry.data;

// "Teaching Assistant · ETH Zurich", omitting whichever is absent.
const attribution = [role, institution].filter(Boolean).join(" · ");

/** "Autumn 2025", or just "2023" where the thing has no term. */
const label = (term: { name?: string; year: number }) =>
  term.name ? `${term.name} ${term.year}` : String(term.year);

const hasNotes = Boolean(entry.body?.trim());
const { Content } = await render(entry);
---

{
  /* No year gutter: something taught over several terms has no single year to
    put there, and the terms line already carries them. */
}
<li class="entry entry--flush">
  <div class="entry__body">
    <h3 class="entry__title">{course}</h3>

    {attribution && <p class="entry__venue">{attribution}</p>}

    <ul class="entry__venues">
      {
        terms.map((term) => (
          <li>
            {term.url ? (
              <a href={term.url} rel="noopener">
                {label(term)}
              </a>
            ) : (
              label(term)
            )}
          </li>
        ))
      }
    </ul>

    <LinkList links={links} label={`Links for ${course}`} />

    {
      hasNotes && (
        <div class="prose">
          <Content />
        </div>
      )
    }
  </div>
</li>
