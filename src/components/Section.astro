---
import Mark from "./Mark.astro";
import { SEED } from "../config";

interface Props {
  id?: string;
  title: string;
  /** Heading level. Sections are h2; the first on a subpage is h1. */
  as?: "h1" | "h2";
}

const { id, title, as: Tag = "h2" }: Props = Astro.props;
const labelId = id ? `${id}-label` : undefined;
---

<section id={id} class="section" aria-labelledby={labelId}>
  {
    /* No viewBox: user units are CSS pixels, so the dashes stay the same size
      at every width. The dash march is a stroke-dashoffset animation rather
      than a transform — see the note in global.css. */
  }
  <svg class="section__rule" aria-hidden="true" focusable="false">
    <line x1="0" y1="0.5" x2="100%" y2="0.5"></line>
  </svg>

  <div class="section__label">
    <Mark key={id ?? title} seed={SEED} />
    <Tag id={labelId} class="label">{title}</Tag>
  </div>

  <div class="section__body">
    <slot />
  </div>
</section>
