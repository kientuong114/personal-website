---
import { NAV } from "../config";
import ExtArrow from "./ExtArrow.astro";
---

<header class="masthead">
  <div class="masthead__inner">
    <a class="masthead__mark" href="/">ktruong.dev</a>
    <nav aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            class="tag"
            href={item.href}
            rel={item.external ? "noopener" : undefined}
          >
            {item.label}
            {item.external && <ExtArrow />}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="masthead__progress" aria-hidden="true"></div>
</header>
